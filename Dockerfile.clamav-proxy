ARG CLAMAV_IMAGE=clamav/clamav@sha256:7dbf7f93f05df0fd9a20bbd9fc59e29cb6a789ffe5eebd0083497e842580f038
FROM ${CLAMAV_IMAGE}

USER root

# Base image is either Alpine (apk, proxychains-ng) or Debian (apt-get, proxychains4).
RUN if command -v apk >/dev/null 2>&1; then \
      apk add --no-cache proxychains-ng; \
    elif command -v apt-get >/dev/null 2>&1; then \
      apt-get update && \
      DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends proxychains4 && \
      rm -rf /var/lib/apt/lists/*; \
    else \
      echo "ERROR: no supported package manager (apk/apt-get) in base image" >&2; \
      exit 1; \
    fi

ARG SOCKS5_HOST=127.0.0.1
ARG SOCKS5_PORT=1080

RUN printf 'strict_chain\nproxy_dns\ntcp_read_time_out 15000\ntcp_connect_time_out 8000\n\n[ProxyList]\nsocks5 %s %s\n' \
      "${SOCKS5_HOST}" "${SOCKS5_PORT}" > /etc/proxychains4.conf && \
    chmod 644 /etc/proxychains4.conf

RUN cat > /usr/local/bin/proxy-freshclam <<'EOF'
#!/bin/sh
set -e
# proxychains requires the first proxy to be a numeric IP when proxy_dns+strict_chain
# is active, and Docker Desktop endpoints (host.docker.internal) are hostnames.
# Resolve the proxy host to an IP and run against a patched copy of the config.
PROXY_LINE=$(sed -n 's/^socks5[[:space:]]*//p' /etc/proxychains4.conf)
PROXY_HOST=${PROXY_LINE%% *}
PROXY_PORT=${PROXY_LINE##* }
case "$PROXY_HOST" in
  *[!0-9.]*)
    PROXY_IP=$(getent hosts "$PROXY_HOST" | awk 'NR == 1 { print $1 }')
    [ -z "$PROXY_IP" ] && PROXY_IP="127.0.0.1"
    sed "s|^socks5[[:space:]].*|socks5 $PROXY_IP $PROXY_PORT|" /etc/proxychains4.conf > /tmp/proxychains4.conf
    exec proxychains4 -f /tmp/proxychains4.conf "$@"
    ;;
esac
exec proxychains4 -f /etc/proxychains4.conf "$@"
EOF

RUN chmod +x /usr/local/bin/proxy-freshclam

USER clamav

ENTRYPOINT ["proxy-freshclam"]
CMD ["freshclam", "--stdout"]
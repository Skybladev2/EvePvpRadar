# LOG_LEVEL=DEBUG enables verbose debug logs. Default: INFO
#LOG_LEVEL=DEBUG
# Killmail stream: R2Z2 (zkillboard ephemeral API, full killmail JSON; no ESI calls)
# R2Z2 request delays (milliseconds): between requests (default 250), on 404 no-data (default 6000)
R2Z2_SLEEP_BETWEEN_MS=250
R2Z2_SLEEP_ON_404_MS=6000
# Max backfill iterations: fill cache up to this many sequence fetches even if old killmails appear (default 700)
MAX_BACKFILL_KILLMAILS=700
SOCKS5_PROXY=
MOCK_DATA=

# Optional: footer link next to Legal info (set both to show; external URL and anchor text)
#DONATE_URL=https://example.com/donate
#DONATE_TEXT=Donate & tech blog

# Domain / URLs for deployment (override for production)
# API_URL controls how the frontend reaches the backend:
#   1) Leave empty when frontend + backend share a domain (reverse proxy /api -> backend)
#   2) Set to https://api.yourdomain.com when backend lives on its own domain/subdomain
#   3) Set to https://yourdomain.com/backend (or similar) when proxying from a subpath; frontend will call <API_URL>/api/*
# The frontend automatically appends /api to the value above.
API_URL=
EVE_SSO_CLIENT_ID=<get it from here https://developers.eveonline.com/applications>
EVE_SSO_CLIENT_SECRET=<get it from here https://developers.eveonline.com/applications>
# For single-domain: https://yourdomain.com/api/auth/callback
# For separate backend: https://api.yourdomain.com/api/auth/callback
EVE_SSO_REDIRECT_URI=http://localhost:8888/api/auth/callback
# Frontend URL (where to redirect after login). Also used as the default credentialed CORS allowlist (normalized origin).
EVE_SSO_FRONTEND_URL=http://localhost:8888
# Optional: extra browser origins for credentialed CORS (comma-separated full URLs, e.g. https://staging.example.com).
CORS_ALLOWED_ORIGINS=
# Optional: force Secure flag on SSO session cookie (true/1/yes). Otherwise set when the request is HTTPS or X-Forwarded-Proto=https.
#EVE_SSO_COOKIE_SECURE=true

# HTTP listen port for the app (default 8080 if unset)
#PORT=8080

# Published ports (host -> container)
FRONTEND_PORT=8888
FRONTEND_METRICS_PORT=9091
BACKEND_PORT=8080

# Frontend nginx Lua rate limits (defaults shown)
RATELIMIT_GLOBAL_RPS=400
RATELIMIT_PER_IP_RPS=5
RATELIMIT_PER_IP_10S=30
RATELIMIT_BLOCK_SEC=3600

# Optional: set to 1 to avoid IPv6 for outbound zKill/R2Z2 connections (see zkillboard-cache)
#DISABLE_IPV6=1

# Required: backend serves /metrics on METRICS_PORT; frontend stub_status on 8080, exporter on 9113
METRICS_PORT=8081

# Required: User-Agent base string for outgoing HTTP (ESI). Commit hash is appended at build time (base+commit).
USER_AGENT=EvEPvpRadarFork

# Grafana (non-default username + complex password)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

FRONTEND_IMAGE=evepvpradar-frontend
BACKEND_IMAGE=evepvpradar-backend
# Debian apt mirror for frontend Docker build. Default below (deb.debian.org / Fastly CDN).
# Override to a reachable mirror if the default CDN is blocked in your region (e.g. http://mirror.yandex.ru/debian/).
#DEBIAN_MIRROR=http://deb.debian.org/debian

# Third-party scanner settings (Trivy/ClamAV) are kept in `.env.scanners`.
# Optional: cap Docker API for trivy-scan when the host Engine is older than Trivy's client (default 1.43)
#DOCKER_API_VERSION=1.43

# Third-party monitoring images are pinned by digest.
# check-third-party-images.sh requires all repo/tag/digest values below.

NGINX_EXPORTER_IMAGE_REPO=nginx/nginx-prometheus-exporter
NGINX_EXPORTER_IMAGE_TAG=latest
NGINX_EXPORTER_IMAGE_DIGEST=sha256:bf76e58df548a13e52bd543ac70f6d3d667e14884e8b51c149bd81994ca75ccd

PROMETHEUS_IMAGE_REPO=prom/prometheus
PROMETHEUS_IMAGE_TAG=latest
PROMETHEUS_IMAGE_DIGEST=sha256:4a61322ac1103a0e3aea2a61ef1718422a48fa046441f299d71e660a3bc71ae9

GRAFANA_IMAGE_REPO=grafana/grafana
GRAFANA_IMAGE_TAG=main-ubuntu
GRAFANA_IMAGE_DIGEST=sha256:a604f143dbb145a16cd58d22b1451826ee59fcf9de561dc6d698b1de222272d0

# Fill when running docker compose without build script
#IMAGE_TAG=